{
  "name": "handoff-extension",
  "version": "0.3.41",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "render:store": "node scripts/render-store.mjs",
    "build:site": "node scripts/build-site.mjs",
    "train:topics": "node --experimental-strip-types --no-warnings scripts/train-topic-head.ts",
    "check:embed": "node --experimental-strip-types --no-warnings scripts/check-embed.ts",
    "build": "wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node evaluation/evaluate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "gpt-tokenizer": "^3.4.0",
    "onnxruntime-web": "1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.5",
    "jsdom": "^26.0.0",
    "puppeteer-core": "25.11.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
