{
  "name": "handoff-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "zip": "wxt zip",
    "smoke": "node scripts/smoke-extension.mjs",
    "render:icons": "node scripts/render-icons.mjs",
    "render:store": "node scripts/render-store.mjs",
    "build:site": "node scripts/build-site.mjs",
    "train:topics": "node --experimental-strip-types --no-warnings scripts/train-topic-head.ts",
    "check:embed": "node --experimental-strip-types --no-warnings scripts/check-embed.ts",
    "build": "wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node evaluation/evaluate.mjs",
    "eval:handoff": "vitest run tests/handoff-fidelity.test.ts --reporter=verbose",
    "eval:drafts": "jiti scripts/handoff-drafts.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "gpt-tokenizer": "^4.1.0",
    "gsap": "^3.15.0",
    "onnxruntime-web": "1.30.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "jsdom": "^26.0.0",
    "puppeteer-core": "25.11.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
